{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "server/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "types/**/*.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "AppData",
    "Downloads",
    "OneDrive",
    "iCloudDrive",
    "iCloudPhotos",
    "Documents",
    "workspace",
    "hermes-workspace",
    "ai-integration-platform",
    "ai-translation-ppt",
    "blue-automation",
    "claw3d",
    "my-genkit-app",
    "functions",
    "coverage",
    "dataconnect",
    "esggo_docs",
    "external_docs",
    "wangdao_v3_dist",
    "hello.univer",
    "backup_files",
    "src/app/wangdao/agentic-mvp-1778843111188.tsx",
    "src/app/wangdao/agentic-mvp-1778843160042.tsx",
    "src/app/wangdao/autonomous-mvp-1778838785430.tsx"
  ]
}
